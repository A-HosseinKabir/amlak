rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // --- Property Validation ---
    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'price', 'type', 'location', 'area', 'images', 'ownerId', 'createdAt'])
        && data.title is string && data.title.size() <= 200
        && data.price is number && data.price >= 0
        && data.type in ['آپارتمان', 'ویلایی', 'اداری', 'زمین']
        && data.location is map
        && data.location.lat is number
        && data.location.lng is number
        && data.location.address is string
        && data.area is number && data.area > 0
        && data.images is list && data.images.size() > 0 && data.images.size() <= 20
        && data.ownerId == request.auth.uid
        && data.createdAt == request.time;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 100;
    }

    // --- Match Blocks ---

    match /properties/{propertyId} {
      allow list: if true; // Public listing
      allow get: if true;
      
      allow create: if isVerified() && isValidProperty(incoming());
      
      allow update: if isVerified() && isOwner(existing().ownerId) && isValidProperty(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt;
      
      allow delete: if isVerified() && isOwner(existing().ownerId);
    }

    match /users/{userId} {
      allow get: if true;
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }

    match /chatRooms/{roomId} {
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in existing().participants;

      match /messages/{messageId} {
        allow list, get: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        allow create: if isSignedIn() 
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && incoming().senderId == request.auth.uid;
      }
    }
  }
}
