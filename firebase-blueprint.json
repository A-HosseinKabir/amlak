{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A real estate property listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "type": { "type": "string", "enum": ["آپارتمان", "ویلایی", "اداری", "زمین"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          },
          "required": ["lat", "lng", "address"]
        },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "area": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } },
        "videoUrl": { "type": "string" },
        "virtualTourUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFeatured": { "type": "boolean" },
        "ownerId": { "type": "string" }
      },
      "required": ["title", "price", "type", "location", "area", "images", "ownerId"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "A chat session between two users about a property",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "propertyId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" }
      },
      "required": ["propertyId", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "timestamp"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Collection of all property listings"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles"
    },
    "/chatRooms/{roomId}": {
      "schema": "ChatRoom",
      "description": "Active chat conversations"
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat room"
    }
  }
}
